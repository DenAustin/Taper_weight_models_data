df_long <- read_csv("df_long_1_7.csv", na = c("", "NA"))


# Convert variables to appropriate types
df_long <- df_long %>%
  mutate(
    Site = factor(Site),
    DBH_class = factor(DBH_class),
    Case = factor(Case) # for random effects
  )
#str(df_long$log_segment)
# Create centered and scaled versions of DSoB and DSuB


df_long <- df_long %>%
  mutate(
    DSoB_c = DSoB - mean(DSoB, na.rm = TRUE),           # Centered
    DSoB_s = scale(DSoB)[, 1],                          # Scaled
    DSuB_c = DSuB - mean(DSuB, na.rm = TRUE),           # Centered
    DSuB_s = scale(DSuB)[, 1],                          # Scaled
    DBH_c = DBH - mean(DBH, na.rm = TRUE),              # Centered
    DBH_s = scale(DBH)[, 1],                            # Scaled
    BT_base = scale(BT_base)[, 1],                      # Scaled
    Length_c = Length - mean(Length, na.rm = TRUE),     # Centered
    Length_s = scale(Length)[, 1],                      # Scaled
    log_segment_num = parse_number(log_segment),                                 # Extract numeric
    log_segment_c = log_segment_num - mean(log_segment_num, na.rm = TRUE)        # Centered
  )


# Transform
df_long$log_weight_sqrt <- sqrt(df_long$log_weight)

summary(as.factor(df_long$Case))
summary(as.factor(df_long$log_segment))


# No complex dispersion DISPFORMULA THE VETHE VERSION DSoB, DSoB,  DSoB
mixed_mdl_tmb_oB <- glmmTMB(
  log_weight_sqrt ~ ns(DSoB, df = 4) * log_segment * Site + DBH_class + (log_segment | Case),
  dispformula = ~ log_segment + Site + BT_base + DBH_class,  # Removed ns(DSoB)
  data = df_long,
  family = gaussian()
)

summary(mixed_mdl_tmb_oB)
library(performance)
VarCorr(mixed_mdl_tmb_oB)

pred <- predict(mixed_mdl_tmb_oB)

pseudo_r2_1 <- 1 - sum((df_long$log_weight_sqrt - pred)^2) /
  sum((df_long$log_weight_sqrt - mean(df_long$log_weight_sqrt))^2)

pseudo_r2_1


# No complex dispersion DISPFORMULA THE VETHE VERSION DSoB, DSoB,  DSoB
mixed_mdl_tmb_uB <- glmmTMB(
  log_weight_sqrt ~ ns(DSuB, df = 4) * log_segment * Site + DBH_class + (log_segment | Case),
  dispformula = ~ log_segment + Site + BT_base + DBH_class,  # Removed ns(DSoB)
  data = df_long,
  family = gaussian()
)

summary(mixed_mdl_tmb_uB)
CClibrary(performance)
VarCorr(mixed_mdl_tmb_uB)

# r2_mixed <- performance::r2(mixed_mdl_tmb_oB)
# r2_mixed

pred2 <- predict(mixed_mdl_tmb_uB)

pseudo_r2 <- 1 - sum((df_long$log_weight_sqrt - pred2)^2) /
