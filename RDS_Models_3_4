########### BACK_TRANSFORM
## ------------------------------------------------------------
## 80:20 STRATIFIED SPLIT
## ------------------------------------------------------------
library(rsample)
set.seed(42)

df_long$strata <- interaction(df_long$log_segment, df_long$Site)

split_80 <- initial_split(df_long, prop = 0.8, strata = strata)
train_df <- training(split_80)
test_df  <- testing(split_80)

## ------------------------------------------------------------
## Restrict to Log5 and Log6 only (avoids missing Log7×Site combos)
## ------------------------------------------------------------
train_df_sub <- train_df %>% filter(log_segment %in% c("Log5", "Log6"))
test_df_sub  <- test_df  %>% filter(log_segment %in% c("Log5", "Log6"))

## ------------------------------------------------------------
## Fit model on restricted training set
## ------------------------------------------------------------
mixed_mdl_train_sub <- glmmTMB(
  log_weight_sqrt ~ ns(DSoB, df = 4) * log_segment * Site +
    DBH_class + (log_segment | Case),
  dispformula = ~ log_segment + Site + BT_base + DBH_class,
  data = train_df_sub,
  family = gaussian()
)

## ------------------------------------------------------------
## Generate predictions (still on sqrt scale)
## ------------------------------------------------------------
train_df_sub$pred_sqrt <- predict(mixed_mdl_train_sub, newdata = train_df_sub, allow.new.levels = TRUE)
test_df_sub$pred_sqrt  <- predict(mixed_mdl_train_sub, newdata = test_df_sub,  allow.new.levels = TRUE)

## ------------------------------------------------------------
## BACK‑TRANSFORM predictions and actual values
## ------------------------------------------------------------
train_df_sub <- train_df_sub %>%
  mutate(
    actual_log_weight     = log_weight_sqrt^2,
    predicted_log_weight  = pred_sqrt^2
  )

test_df_sub <- test_df_sub %>%
  mutate(
    actual_log_weight     = log_weight_sqrt^2,
    predicted_log_weight  = pred_sqrt^2
  )

## ------------------------------------------------------------
## Create clean Actual vs Predicted tables
## ------------------------------------------------------------
actual_vs_pred_train <- train_df_sub[, c("actual_log_weight", "predicted_log_weight")]
actual_vs_pred_test  <- test_df_sub[,  c("actual_log_weight", "predicted_log_weight")]

names(actual_vs_pred_train) <- c("actual", "predicted")
names(actual_vs_pred_test)  <- c("actual", "predicted")

## ------------------------------------------------------------
## Print results
## ------------------------------------------------------------
actual_vs_pred_train
actual_vs_pred_test

